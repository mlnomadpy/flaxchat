# Python bytecode, packaging and tool caches
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
/build/
/dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.ipynb_checkpoints/
.coverage
.coverage.*
htmlcov/
coverage.xml
coverage.json

# Local environments; dependency lockfiles remain versionable
.venv/
venv/
.pixi/

# Editors and operating-system files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Local secrets; checked-in examples are allowed
.env
.env.*
!.env.example
!.env.template
.secrets/
.credentials/
application_default_credentials.json

# Downloaded datasets, model exports and numerical payloads
# Anchor these folders so source packages such as flaxchat/models remain visible.
/exports/
/models/
/data/
*.tflite
*.stablehlo
*.pkl
*.npz

# Experiment artifacts: expose authored campaign-root builders, not copied source trees.
/artifacts/*
!/artifacts/*/
/artifacts/*/*
!/artifacts/*/*.py
!/artifacts/*/*.sh

# Generated payloads inside operational docs; keep .py/.sh sources, JSON receipts,
# recipes, manifests, model cards, benchmark tables and restore instructions visible.
docs/**/*.npy
docs/**/*.npz
docs/**/*.safetensors
docs/**/*.bin
docs/**/*.whl
docs/**/*.bundle
docs/**/*.tar
docs/**/*.tar.*
docs/**/*.zip
docs/**/*.gz
docs/**/*.bz2
docs/**/*.xz
docs/**/*.zst
docs/**/*.incomplete
docs/**/*.sqlite
docs/**/*.sqlite-*
docs/**/*.stablehlo
docs/**/*.stablehlo.txt
docs/**/*.xplane.pb
docs/**/ocdbt.process_*/
docs/**/manifest.ocdbt
docs/**/torch-wheels/
docs/**/checkpoints/

