# Download caches, logs and experiment tracking
.cache/
wandb/
*.log
*.prof
tensorboard/

# Source-controlled recipes and intentionally small test fixtures
!configs/data/
!configs/data/*.json
!tests/fixtures/
!tests/fixtures/**

# Machine-local operational/account observations; never hide Python source or lockfiles.
*-local.json
*-local.jsonl
*-local.txt
*-local.md
*_local.json
*_local.jsonl
*_local.txt
*_local.md
docs/**/credit-observation*.json
docs/**/credit-check*.json
docs/**/billing-observation*.json

# Jekyll output
/docs/_site/
/docs/.jekyll-cache/
/docs/.sass-cache/

# The dacli workspace lives on its own ref (dacli-record), not on trunk: records
# carried on a branch fork with it, so a task closed on a task branch is
# invisible on trunk until its record merges. The history is NOT lost —
#   git log dacli-record
#   git show dacli-record:.dacli/projects/<p>/tasks/done/<file>
.dacli/

# Local operational audit receipts; reviewed metadata fixtures live in tests/fixtures.
docs/audit-2026-09-30/
